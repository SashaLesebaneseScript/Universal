local FH = getgenv().FH
if not FH or FH.extraLoaded then return end
FH.extraLoaded = true

local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local cfg = { overlay = false }

local ov = Instance.new("TextLabel")
ov.Size = UDim2.new(0, 150, 0, 24)
ov.Position = UDim2.new(0, 84, 0, 118)
ov.BackgroundColor3 = FH.C.bg_dark
ov.BackgroundTransparency = .35
ov.BorderSizePixel = 0
ov.Text = "-- FPS | -- ms"
ov.TextColor3 = FH.C.text
ov.TextSize = 13
ov.Font = Enum.Font.GothamBold
ov.Visible = false
ov.ZIndex = 0
ov.Parent = FH.sg
Instance.new("UICorner", ov).CornerRadius = UDim.new(0, 8)

local acc, frames = 0, 0
FH.bind(FH.RS.RenderStepped, function(dt)
    if not cfg.overlay then return end
    acc = acc + dt
    frames = frames + 1
    if acc >= 0.5 then
        local ping = 0
        pcall(function()
            ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
        end)
        ov.Text = math.floor(frames / acc) .. " FPS | " .. ping .. " ms"
        acc, frames = 0, 0
    end
end)

local afkConn
FH.onUnload(function()
    if afkConn then afkConn:Disconnect() end
end)

local function setAfk(s)
    if afkConn then afkConn:Disconnect() afkConn = nil end
    if s then
        afkConn = FH.LP.Idled:Connect(function()
            local vu = game:GetService("VirtualUser")
            vu:CaptureController()
            vu:ClickButton2(Vector2.new())
        end)
    end
end

local function hop()
    FH.notify("Searching servers...")
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    end)
    if ok and res and res.data then
        for _, s in ipairs(res.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, FH.LP)
                return
            end
        end
    end
    FH.notify("No servers found", false)
end

local function copy(text, label)
    local cp = setclipboard or toclipboard
    if cp then
        cp(text)
        FH.notify(label .. " copied")
    else
        FH.notify("Clipboard not supported", false)
    end
end

FH.modules["Extra"] = function()
    FH.crearSeccion("Utility")
    FH.crearOpcion("Anti AFK", setAfk, "Prevents getting kicked for idling")
    FH.crearOpcion("FPS and Ping", function(s)
        cfg.overlay = s
        ov.Visible = s
    end, "Small counter on screen")

    FH.crearSeccion("Server")
    FH.crearBotonAccion("Rejoin Server", function()
        TeleportService:Teleport(game.PlaceId, FH.LP)
    end)
    FH.crearBotonAccion("Server Hop", function()
        task.spawn(hop)
    end)
    FH.crearBotonAccion("Copy Place ID", function()
        copy(tostring(game.PlaceId), "Place ID")
    end)
    FH.crearBotonAccion("Copy Job ID", function()
        copy(game.JobId, "Job ID")
    end)

    FH.crearSeccion("Character")
    FH.crearBotonAccion("Reset Character", function()
        local c = FH.LP.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.Health = 0 end
    end)
end
