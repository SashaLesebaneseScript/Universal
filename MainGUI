FH.setAccent = function(name)
    local col = FH.presets[name]
    if not col then return end
    C.accent = col
    C.accent2 = col:Lerp(Color3.new(0, 0, 0), 0.25)
    C.border = col:Lerp(Color3.new(1, 1, 1), 0.2)
    local alive = {}
    for _, t in ipairs(FH.themeList) do
        if t[1].Parent then
            t[1][t[2]] = C[t[3]]
            table.insert(alive, t)
        end
    end
    FH.themeList = alive
    for _, fn in ipairs(FH.themeFns) do pcall(fn) end
end

FH.unload = function()
    for _, fn in ipairs(FH.unloadFns) do pcall(fn) end
    for _, c in ipairs(FH.conns) do pcall(function() c:Disconnect() end) end
    for _, c in ipairs(FH.panelConns) do pcall(function() c:Disconnect() end) end
    if FH.ls then pcall(function() FH.ls:Destroy() end) end
    if FH.sg then pcall(function() FH.sg:Destroy() end) end
    getgenv().FH = nil
end

