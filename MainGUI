    local b = Instance.new("Frame", sw)
    b.Size = UDim2.new(0,20,0,20); b.Position = UDim2.new(0,3,.5,-10); b.BackgroundColor3 = C.text_sub; b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(1,0)
    local state = FH.est[key]
    local function setV(a, anim)
        local t = anim and .3 or 0
        local info = TweenInfo.new(t, anim and Enum.EasingStyle.Back or Enum.EasingStyle.Linear)
        if a then
            FH.TW:Create(b, info, {Position = UDim2.new(0,25,.5,-10), BackgroundColor3 = C.accent, Size = UDim2.new(0,22,0,22)}):Play()
            FH.TW:Create(sw, info, {BackgroundColor3 = C.accent2}):Play()
            FH.TW:Create(ts, info, {Color = C.accent, Transparency = 0}):Play()
            grad.Color = ColorSequence.new(C.accent2, C.accent)
        else
            FH.TW:Create(b, info, {Position = UDim2.new(0,3,.5,-10), BackgroundColor3 = C.text_sub, Size = UDim2.new(0,20,0,20)}):Play()
            FH.TW:Create(sw, info, {BackgroundColor3 = C.bg_dark}):Play()
            FH.TW:Create(ts, info, {Color = C.border, Transparency = .2}):Play()
            grad.Color = ColorSequence.new(Color3.fromRGB(60,30,70), Color3.fromRGB(40,20,50))
        end
    end
    setV(state, false)
    local function toggle()
        state = not state; FH.est[key] = state; setV(state, true)
        FH.sfx(state and "toggle_on" or "toggle_off")
        if cb then pcall(cb, state) end
    end
    sw.MouseButton1Click:Connect(toggle)
    l.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then toggle() end
    end)
    FH.animar(sw)
end

