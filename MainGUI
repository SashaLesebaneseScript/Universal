local function setOpen(state)
    if isAnimating or state == isOpen then return end
    isAnimating = true
    if state then
        fr.Visible = true
        fr.Size = UDim2.new(0, 0, 0, 0)
        pcall(FH.panel)
        FH.TW:Create(fr, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, FH.BW, 0, FH.BH) }):Play()
