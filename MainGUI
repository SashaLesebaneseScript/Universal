FH.animar = function(obj)
    local base = obj.Size
    obj.MouseEnter:Connect(function()
        FH.TW:Create(obj, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Size = base + UDim2.new(0, 4, 0, 4) }):Play()
