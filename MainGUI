    obj.MouseLeave:Connect(function()
        FH.TW:Create(obj, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {Size = base}):Play()
    end)
end

FH.unload = function()
    for _, fn in ipairs(FH.unloadFns) do pcall(fn) end
    for _, c in ipairs(FH.conns) do pcall(function() c:Disconnect() end) end
    if FH.ls then pcall(function() FH.ls:Destroy() end) end
    if FH.sg then pcall(function() FH.sg:Destroy() end) end
    getgenv().FH = nil
end

