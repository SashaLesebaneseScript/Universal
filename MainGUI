    l.ZIndex = 50
    local info = TweenInfo.new(.2)
    FH.TW:Create(t, info, { BackgroundTransparency = .1 }):Play()
    FH.TW:Create(s, info, { Transparency = .2 }):Play()
    FH.TW:Create(l, info, { TextTransparency = 0 }):Play()
    task.delay(2, function()
        pcall(function()
            FH.TW:Create(t, info, { BackgroundTransparency = 1 }):Play()
            FH.TW:Create(s, info, { Transparency = 1 }):Play()
            FH.TW:Create(l, info, { TextTransparency = 1 }):Play()
