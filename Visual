local FH = getgenv().FH
if not FH or FH.visualLoaded then return end
FH.visualLoaded = true
FH.modules["Visual"] = {}

FH.modules["Visual"].panel = function()
    FH.addLabel("Visual", "visual")
    FH.addToggle("Visual", "Remove Fog", function(on)
        local L = game:GetService("Lighting")
        if on then
            FH._fog = {FogEnd = L.FogEnd, FogStart = L.FogStart}
            L.FogEnd = 100000
            L.FogStart = 0
        elseif FH._fog then
            L.FogEnd = FH._fog.FogEnd
            L.FogStart = FH._fog.FogStart
            FH._fog = nil
        end
    end)
    FH.addToggle("Visual", "Remove Shadows", function(on)
        local L = game:GetService("Lighting")
        if on then
            FH._shadow = L.GlobalShadows
            L.GlobalShadows = false
        else
            if FH._shadow ~= nil then
                L.GlobalShadows = FH._shadow
            end
        end
    end)
end
