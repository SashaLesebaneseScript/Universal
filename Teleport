local FH = getgenv().FH
if not FH or FH.tpLoaded then return end
FH.tpLoaded = true

local saved = {}
local viewing = nil

local function myParts()
    local c = FH.LP.Character
    return c and c:FindFirstChildOfClass("Humanoid"), c and c:FindFirstChild("HumanoidRootPart")
end

local function stopView()
    viewing = nil
    local hum = myParts()
    local cam = FH.WS.CurrentCamera
    if hum and cam then cam.CameraSubject = hum end
end

FH.onUnload(stopView)

local function tpTo(p)
    local _, hrp = myParts()
    local tc = p.Character
    local thr = tc and tc:FindFirstChild("HumanoidRootPart")
    if hrp and thr then
        hrp.CFrame = CFrame.new(thr.Position + Vector3.new(3, 2, 0))
        FH.notify("Teleported to " .. p.DisplayName)
    end
end

local function view(p)
    local tc = p.Character
    local th = tc and tc:FindFirstChildOfClass("Humanoid")
    local cam = FH.WS.CurrentCamera
    if th and cam then
        viewing = p
        cam.CameraSubject = th
        FH.notify("Viewing " .. p.DisplayName)
    end
end

local function row(p)
    local o = FH.card(44)
    local l = Instance.new("TextLabel", o)
    l.Size = UDim2.new(1, -140, 1, 0)
    l.Position = UDim2.new(0, 14, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = p.DisplayName == p.Name and p.Name or (p.DisplayName .. " @" .. p.Name)
    l.TextColor3 = FH.C.text
    l.TextSize = 13
    l.Font = Enum.Font.GothamBold
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd

    local function btn(text, x, fn)
        local b = Instance.new("TextButton", o)
        b.Size = UDim2.new(0, 52, 0, 26)
        b.Position = UDim2.new(1, x, .5, -13)
        b.Text = text
        b.TextColor3 = Color3.new(1, 1, 1)
        b.TextSize = 13
        b.Font = Enum.Font.GothamBold
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        FH.theme(b, "BackgroundColor3", "accent2")
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
        b.MouseButton1Click:Connect(function()
            FH.sfx("button", 1, 1.3)
            pcall(fn)
        end)
    end
    btn("TP", -118, function() tpTo(p) end)
    btn("View", -60, function() view(p) end)
end

local function refresh()
    if FH.pestana == "Teleport" and FH.fr.Visible then task.defer(FH.panel) end
end

FH.bind(FH.PL.PlayerAdded, function() task.delay(.3, refresh) end)
FH.bind(FH.PL.PlayerRemoving, function(p)
    if viewing == p then stopView() end
    task.delay(.3, refresh)
end)

FH.modules["Teleport"] = function()
    FH.crearSeccion("Players")
    FH.crearBotonAccion("Stop Viewing", stopView)
    local list = FH.PL:GetPlayers()
    table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
    local n = 0
    for _, p in ipairs(list) do
        if p ~= FH.LP then
            n = n + 1
            row(p)
        end
    end
    if n == 0 then FH.crearLabel("No other players in this server.") end

    FH.crearSeccion("Places")
    FH.crearBotonAccion("Teleport to Spawn", function()
        local _, hrp = myParts()
        local sp = FH.WS:FindFirstChildWhichIsA("SpawnLocation", true)
        if hrp and sp then
            hrp.CFrame = sp.CFrame + Vector3.new(0, 4, 0)
            FH.notify("Teleported to spawn")
        else
            FH.notify("No spawn found", false)
        end
    end)
    FH.crearBotonAccion("Teleport to Random Player", function()
        local list2 = {}
        for _, p in ipairs(FH.PL:GetPlayers()) do
            if p ~= FH.LP and p.Character then table.insert(list2, p) end
        end
        if #list2 > 0 then tpTo(list2[math.random(#list2)]) end
    end)

    FH.crearSeccion("Saved Positions")
    FH.crearSelector("Save Slot", { "1", "2", "3" }, "1", function() end)
    FH.crearBotonAccion("Save Position", function()
        local _, hrp = myParts()
        if hrp then
            saved[FH.val["Save Slot"]] = hrp.CFrame
            FH.notify("Saved to slot " .. FH.val["Save Slot"])
        end
    end)
    FH.crearBotonAccion("Go to Saved Position", function()
        local _, hrp = myParts()
        local cf = saved[FH.val["Save Slot"]]
        if hrp and cf then
            hrp.CFrame = cf
            FH.notify("Teleported to slot " .. FH.val["Save Slot"])
        else
            FH.notify("Slot is empty", false)
        end
    end)
end
