local FH = getgenv().FH
if not FH or FH.tpLoaded then return end
FH.tpLoaded = true
FH.modules["Teleport"] = {}

local function tweenTo(pos)
    local char = FH.LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local dist = (hrp.Position - pos).Magnitude
    if dist > 2000 then
        hrp.CFrame = CFrame.new(pos)
    else
        local tween = FH.TW:Create(hrp, TweenInfo.new(dist / 100, Enum.EasingStyle.Linear), {CFrame = CFrame.new(pos)})
        tween:Play()
    end
end

FH.modules["Teleport"].panel = function()
    FH.addLabel("Teleport", "teleport")
    FH.addButton("Teleport", "go_spawn", function()
        local spawn = workspace:FindFirstChildOfClass("SpawnLocation")
        if spawn then
            tweenTo(spawn.Position + Vector3.new(0, 3, 0))
        end
    end)
    FH.addButton("Teleport", "go_player", function()
        local nearest = FH.nearest()
        if nearest and nearest.HRP then
            tweenTo(nearest.HRP.Position + Vector3.new(0, 3, 0))
        end
    end)
    FH.addButton("Teleport", "save_pos", function()
        local char = FH.LP.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            FH.savedPos = char.HumanoidRootPart.CFrame
        end
    end)
    FH.addButton("Teleport", "load_pos", function()
        if FH.savedPos then
            tweenTo(FH.savedPos.Position)
        end
    end)
end
