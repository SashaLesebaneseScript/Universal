local FH = getgenv().FH
if not FH or FH.aimLoaded then return end
FH.aimLoaded = true
FH.modules["Aimbot"] = {}

local cfg = {
    on = false, team = false, wall = false, ignoreFriends = false,
    showFov = false, fov = 150, smooth = 40, part = "Head"
}

local circle = Instance.new("Frame")
circle.Name = "FH_FOV"
circle.AnchorPoint = Vector2.new(.5, .5)
circle.Position = UDim2.new(.5, 0, .5, 0)
circle.BackgroundTransparency = 1
circle.BorderSizePixel = 0
circle.Visible = false
circle.ZIndex = 0
circle.Parent = FH.sg
Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
local cs = Instance.new("UIStroke", circle); cs.Thickness = 1.5
FH.theme(cs, "Color", "accent")

local function updCircle()
    local s = FH.us.Scale; if s <= 0 then s = 1 end
    local d = cfg.fov * 2 / s
    circle.Size = UDim2.fromOffset(d, d)
    circle.Visible = cfg.on and cfg.showFov
end

local fc = {}
local function isFriend(p)
    local v = fc[p.UserId]
    if v == nil then
        fc[p.UserId] = false
        task.spawn(function()
            local ok, r = pcall(function() return FH.LP:IsFriendsWith(p.UserId) end)
            fc[p.UserId] = ok and r or false
        end)
        return false
    end
    return v
end

local function aimPart(char)
    if cfg.part == "Torso" then return char:FindFirstChild("HumanoidRootPart") end
    return char:FindFirstChild("Head")
end

local function getTarget(cam)
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local best, bestD = nil, cfg.fov
    for _, p in ipairs(FH.PL:GetPlayers()) do
        local skip = p == FH.LP or not p.Character
        if not skip and cfg.team and FH.LP.Team ~= nil and p.Team == FH.LP.Team then skip = true end
        if not skip and cfg.ignoreFriends and isFriend(p) then skip = true end
        if not skip then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            local part = aimPart(p.Character)
            if hum and part and hum.Health > 0 then
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < bestD then
                        local visible = true
                        if cfg.wall then
                            local rp = RaycastParams.new()
                            rp.FilterType = Enum.RaycastFilterType.Exclude
                            rp.FilterDescendantsInstances = { FH.LP.Character, p.Character }
                            visible = FH.WS:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rp) == nil
                        end
                        if visible then best, bestD = part, d end
                    end
                end
            end
        end
    end
    return best
end

FH.bind(FH.RS.RenderStepped, function()
    updCircle()
    if not cfg.on then return end
    local touchOnly = FH.UI.TouchEnabled and not FH.UI.MouseEnabled
    if not touchOnly and not FH.UI:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return end
    local cam = FH.WS.CurrentCamera; if not cam then return end
    local t = getTarget(cam)
    if t then
        local alpha = math.clamp(1 - cfg.smooth / 100, 0.02, 1)
        cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, t.Position), alpha)
    end
end)

FH.modules["Aimbot"].panel = function()
    FH.addToggle("Aimbot", "Enable Aimbot", function(on) cfg.on = on end)
    FH.addToggle("Aimbot", "Team Check", function(on) cfg.team = on end)
    FH.addToggle("Aimbot", "Wall Check", function(on) cfg.wall = on end)
    FH.addToggle("Aimbot", "Ignore Friends", function(on) cfg.ignoreFriends = on end)
    FH.addToggle("Aimbot", "Show FOV Circle", function(on) cfg.showFov = on end)
    FH.addSlider("Aimbot", "FOV", 10, 500, 150, function(v) cfg.fov = v end)
    FH.addSlider("Aimbot", "Smoothness", 1, 100, 40, function(v) cfg.smooth = v end)
end
