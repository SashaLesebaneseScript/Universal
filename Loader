if getgenv().FH and getgenv().FH.p1 then return end

local TweenService = game:GetService("TweenService")
local base = "https://raw.githubusercontent.com/TU_USUARIO/TU_REPO/main/"
local files = { "MainGUI", "ESP", "Aimbot", "Player", "Extra" }

local total = #files
local timestamp = tick()

local function fail(msg)
    local FH = getgenv().FH
    if FH and FH.lsText then
        FH.lsText.Text = msg
        FH.lsText.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
    warn("[FH] " .. msg)
    task.wait(3)
    if FH then
        if FH.ls then FH.ls:Destroy() end
        if FH.sg then FH.sg:Destroy() end
    end
    getgenv().FH = nil
end

for i, file in ipairs(files) do
    local FH = getgenv().FH
    if FH and FH.lsText then
        FH.lsText.Text = "Loading " .. file .. " page..."
    end

    local url = base .. file .. ".lua?t=" .. tostring(math.floor(timestamp))
    local ok, code = pcall(function() return game:HttpGet(url) end)
    if not ok or type(code) ~= "string" or code == "" then
        return fail("Error descargando " .. file)
    end

    local fn, err = loadstring(code)
    if not fn then
        return fail("Error de sintaxis en " .. file)
    end

    local ok2, err2 = pcall(fn)
    if not ok2 then
        warn("[FH] " .. file .. ": " .. tostring(err2))
        return fail("Error ejecutando " .. file)
    end

    FH = getgenv().FH
    if FH and FH.lsFill then
        TweenService:Create(FH.lsFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            Size = UDim2.new(i / total, 0, 1, 0)
        }):Play()
    end
end

local FH = getgenv().FH
if FH then
    FH.lsText.Text = "Done!"
    task.wait(0.4)
    pcall(FH.panel)
    if FH.ls then FH.ls:Destroy() end
    FH.sg.Enabled = true
end
