if getgenv().FH and getgenv().FH.p1 then return end

local TweenService = game:GetService("TweenService")
local base = "https://raw.githubusercontent.com/SashaLesebaneseScript/Universal/refs/heads/main/"
local files = { "MainGUI", "ESP", "Aimbot", "Player", "Extra" }

local total = #files
local timestamp = tick()

local function fail(msg)
    local FH = getgenv().FH
    if FH and FH.lsText then
        FH.lsText.Text = msg
        FH.lsText.TextColor3 = Color3.fromRGB(255, 50, 50)
    end
    task.wait(3)
    if FH then
        if FH.ls then FH.ls:Destroy() end
        if FH.sg then FH.sg:Destroy() end
    end
    getgenv().FH = nil
end

local function download(url)
    for _ = 1, 3 do
        local ok, code = pcall(function() return game:HttpGet(url) end)
        if ok and type(code) == "string" and code ~= "" and not code:find("^404") then
            return code
        end
        task.wait(0.5)
    end
    return nil
end

for i, file in ipairs(files) do
    local FH = getgenv().FH
    if FH and FH.lsText then
        FH.lsText.Text = "Loading " .. file .. " page..."
    end

    local code = download(base .. file .. "?t=" .. tostring(math.floor(timestamp)))
    if not code then
        return fail("Failed to download " .. file)
    end

    local fn = loadstring(code)
    if not fn then
        return fail("Syntax error in " .. file)
    end

    local ok = pcall(fn)
    if not ok then
        return fail("Failed to run " .. file)
    end

    FH = getgenv().FH
    if FH and FH.lsFill then
        TweenService:Create(FH.lsFill, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            Size = UDim2.new(i / total, 0, 1, 0)
        }):Play()
    end
end

local FH = getgenv().FH
if FH then
    FH.lsText.Text = "Done!"
    task.wait(0.4)
    pcall(FH.panel)
    if FH.ls then FH.ls:Destroy() end
    FH.sg.Enabled = true
end
