local TweenService = game:GetService("TweenService")
local base = "https://raw.githubusercontent.com/SashaLesebaneseScript/Universal/refs/heads/main/"
local files = {
    "MainGUI",
    "ESP",
    "Aimbot",
    "Player",
    "Visual",
    "Teleport",
    "Settings",
    "Extra"
}

local totalFiles = #files
local timestamp = tick()

for i, file in ipairs(files) do
    if getgenv().FH and getgenv().FH.lsText then
        getgenv().FH.lsText.Text = "Loading " .. file .. "..."
    end
    local endProgress = i / totalFiles
    local url = base .. file .. "?t=" .. tostring(math.floor(timestamp))
    local ok, code = pcall(function() return game:HttpGet(url, true) end)
    local waitTime = math.random(15, 25) / 10
    if getgenv().FH and getgenv().FH.lsFill then
        local tween = TweenService:Create(getgenv().FH.lsFill, TweenInfo.new(waitTime, Enum.EasingStyle.Linear), {Size = UDim2.new(endProgress, 0, 1, 0)})
        tween:Play()
        tween.Completed:Wait()
    else
        task.wait(waitTime)
    end
    if ok and code and code ~= "" and not code:find("404: Not Found") then
        local fn = loadstring(code)
        if fn then pcall(fn) end
    end
    task.wait(0.1)
end

if getgenv().FH then
    if getgenv().FH.lsFrame then
        TweenService:Create(getgenv().FH.lsFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
        task.wait(0.3)
    end
    if getgenv().FH.ls then getgenv().FH.ls:Destroy() end
    if getgenv().FH.sg then getgenv().FH.sg.Enabled = true end
    if getgenv().FH.fr then
        getgenv().FH.fr.Size = UDim2.new(0, 0, 0, 0)
        getgenv().FH.fr.Visible = true
        TweenService:Create(getgenv().FH.fr, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, getgenv().FH.BW, 0, getgenv().FH.BH)}):Play()
    end
    if getgenv().FH.panel then pcall(getgenv().FH.panel) end
end
