local FH = getgenv().FH
if not FH or FH.espLoaded then return end
FH.espLoaded = true
FH.modules["ESP"] = {}

local drawing = {}
local espConn = nil

local function createESP(player)
    local sg = FH.sg
    local box = Instance.new("Frame", sg)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    local stroke = Instance.new("UIStroke", box)
    stroke.Color = FH.C.accent
    stroke.Thickness = 1.5

    local nameLbl = Instance.new("TextLabel", sg)
    nameLbl.BackgroundTransparency = 1
    nameLbl.TextColor3 = FH.C.text
    nameLbl.Font = Enum.Font.GothamBold
    nameLbl.TextSize = 12
    nameLbl.Visible = false
    nameLbl.Text = player.Name

    local hpBG = Instance.new("Frame", sg)
    hpBG.BackgroundColor3 = Color3.new(0, 0, 0)
    hpBG.BorderSizePixel = 0
    hpBG.Visible = false
    Instance.new("UICorner", hpBG).CornerRadius = UDim.new(0, 2)

    local hpFill = Instance.new("Frame", hpBG)
    hpFill.BackgroundColor3 = FH.C.success
    hpFill.BorderSizePixel = 0
    hpFill.Size = UDim2.new(1, 0, 1, 0)
    Instance.new("UICorner", hpFill).CornerRadius = UDim.new(0, 2)

    local distLbl = Instance.new("TextLabel", sg)
    distLbl.BackgroundTransparency = 1
    distLbl.TextColor3 = FH.C.accent4
    distLbl.Font = Enum.Font.GothamBold
    distLbl.TextSize = 11
    distLbl.Visible = false

    drawing[player] = {box=box, stroke=stroke, name=nameLbl, hpBG=hpBG, hpFill=hpFill, dist=distLbl}
end

local function clearESP()
    for _, d in pairs(drawing) do
        for _, obj in pairs(d) do
            if typeof(obj) == "Instance" then obj:Destroy() end
        end
    end
    drawing = {}
end

local function updateESP()
    local cam = workspace.CurrentCamera
    local opts = {
        Box = FH.est["ESP/Box ESP"],
        Name = FH.est["ESP/Name ESP"],
        Health = FH.est["ESP/Health ESP"],
        Distance = FH.est["ESP/Distance"],
        Max = FH.est["ESP/Max Distance"] or 1000,
    }
    local myChar = FH.LP.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(FH.PL:GetPlayers()) do
        if player ~= FH.LP then
            local d = drawing[player]
            if not d then createESP(player); d = drawing[player] end
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            if hrp and head and hum and hum.Health > 0 and myHRP then
                local dist = (myHRP.Position - hrp.Position).Magnitude
                local headPos = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
                local hrpPos = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2.5, 0))
                local onScreen = (headPos.Z > 0)

                if onScreen and dist <= opts.Max then
                    local height = math.abs(headPos.Y - hrpPos.Y)
                    local width = height / 2
                    local x = math.min(headPos.X, hrpPos.X) - width / 2
                    local y = math.min(headPos.Y, hrpPos.Y)

                    d.box.Visible = opts.Box
                    d.box.Position = UDim2.new(0, x, 0, y)
                    d.box.Size = UDim2.new(0, width, 0, height)
                    d.stroke.Color = (hum.Health < hum.MaxHealth * 0.3) and Color3.fromRGB(255,50,50) or FH.C.accent

                    d.name.Visible = opts.Name
                    d.name.Position = UDim2.new(0, x + width/2 - 100, 0, y - 18)
                    d.name.Size = UDim2.new(0, 200, 0, 16)
                    d.name.Text = player.Name

                    d.hpBG.Visible = opts.Health
                    d.hpBG.Position = UDim2.new(0, x - 8, 0, y)
                    d.hpBG.Size = UDim2.new(0, 4, 0, height)
                    d.hpFill.Size = UDim2.new(1, 0, hum.Health / hum.MaxHealth, 0)
                    d.hpFill.Position = UDim2.new(0, 0, 1 - hum.Health / hum.MaxHealth, 0)
                    d.hpFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - hum.Health/hum.MaxHealth), 255 * (hum.Health/hum.MaxHealth), 60)

                    d.dist.Visible = opts.Distance
                    d.dist.Position = UDim2.new(0, x + width/2 - 100, 0, y + height + 2)
                    d.dist.Size = UDim2.new(0, 200, 0, 14)
                    d.dist.Text = math.floor(dist) .. "m"
                else
                    d.box.Visible = false; d.name.Visible = false; d.hpBG.Visible = false; d.dist.Visible = false
                end
            else
                d.box.Visible = false; d.name.Visible = false; d.hpBG.Visible = false; d.dist.Visible = false
            end
        end
    end
end

local function setLoop(on)
    if on and not espConn then
        espConn = FH.RS.RenderStepped:Connect(updateESP)
    elseif not on and espConn then
        espConn:Disconnect(); espConn = nil
        clearESP()
    end
end

FH.modules["ESP"].panel = function()
    FH.addToggle("ESP", "enable_esp", function(on) setLoop(on) end)
    FH.addToggle("ESP", "box_esp", nil, true)
    FH.addToggle("ESP", "name_esp", nil, true)
    FH.addToggle("ESP", "health_esp", nil, true)
    FH.addToggle("ESP", "distance", nil, true)
    FH.addSlider("ESP", "max_dist", 100, 5000, 1000)
    FH.addLabel("ESP", "fullbright")
    FH.addToggle("ESP", "fullbright", function(on)
        local L = game:GetService("Lighting")
        if on then
            FH._fb = {Brightness=L.Brightness, Ambient=L.Ambient, OutdoorAmbient=L.OutdoorAmbient, FogEnd=L.FogEnd}
            L.Brightness = 2; L.Ambient = Color3.new(1,1,1); L.OutdoorAmbient = Color3.new(1,1,1); L.FogEnd = 100000
        elseif FH._fb then
            L.Brightness = FH._fb.Brightness; L.Ambient = FH._fb.Ambient; L.OutdoorAmbient = FH._fb.OutdoorAmbient; L.FogEnd = FH._fb.FogEnd
            FH._fb = nil
        end
    end)
end

FH.PL.PlayerRemoving:Connect(function(p)
    if drawing[p] then
        for _, o in pairs(drawing[p]) do if typeof(o) == "Instance" then o:Destroy() end end
        drawing[p] = nil
    end
end)
