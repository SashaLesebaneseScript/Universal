local FH = getgenv().FH
if not FH or FH.settingsLoaded then return end
FH.settingsLoaded = true

local last = FH.val["Accent Color"] or "Pink"

FH.modules["Settings"] = function()
    FH.crearSeccion("Appearance")
    FH.crearSelector("Accent Color", FH.presetOrder, "Pink", function(v)
        if v ~= last then
            last = v
            FH.setAccent(v)
            task.defer(FH.panel)
        end
    end)
    FH.crearSlider("UI Scale", 50, 130, math.floor(FH.us.Scale * 100 + 0.5), function(v)
        FH.us.Scale = v / 100
    end)

    FH.crearSeccion("General")
    FH.crearOpcion("Notifications", function(s) FH.notifs = s end, "Small pop-ups when toggling features", true)
    FH.crearLabel("PC: press RightShift to show or hide the hub. Drag the F button to move it.")

    FH.crearSeccion("Danger Zone")
    FH.crearBotonAccion("Unload Hub", function()
        FH.unload()
    end)
end
