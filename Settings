local FH = getgenv().FH
if not FH or FH.settingsLoaded then return end
FH.settingsLoaded = true
FH.modules["Settings"] = {}

FH.modules["Settings"].panel = function()
    FH.addLabel("Settings", "language")
    FH.addButton("Settings", "en", function()
        FH.lang = "en"
        FH.panel()
    end)
    FH.addButton("Settings", "es", function()
        FH.lang = "es"
        FH.panel()
    end)
    FH.addButton("Settings", "pt", function()
        FH.lang = "pt"
        FH.panel()
    end)
end
