local FH = getgenv().FH
if not FH or FH.playerLoaded then return end
FH.playerLoaded = true
FH.modules["Player"] = {}

local flyBV, flyBG, flyConn
local noclipConn
local infJumpConn

FH.modules["Player"].panel = function()
    FH.addLabel("Player", "Movement")
    FH.addSlider("Player", "WalkSpeed", 16, 500, 16, function(v)
        local char = FH.LP.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char.Humanoid.WalkSpeed = v
        end
    end)
    FH.addSlider("Player", "JumpPower", 50, 500, 50, function(v)
        local char = FH.LP.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char.Humanoid.UseJumpPower = true
            char.Humanoid.JumpPower = v
        end
    end)

    FH.addToggle("Player", "Fly", function(on)
        local char = FH.LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if on and hrp then
            flyBV = Instance.new("BodyVelocity", hrp)
            flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            flyBV.Velocity = Vector3.new(0,0,0)
            flyConn = FH.RS.RenderStepped:Connect(function()
                local cam = workspace.CurrentCamera
                local moveDir = Vector3.new(0,0,0)
                if FH.UI:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
                if FH.UI:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
                if FH.UI:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
                if FH.UI:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
                if FH.UI:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.new(0,1,0) end
                if moveDir.Magnitude > 0 then moveDir = moveDir.Unit * 50 end
                if flyBV then flyBV.Velocity = moveDir end
            end)
        else
            if flyConn then flyConn:Disconnect() flyConn = nil end
            if flyBV then flyBV:Destroy() flyBV = nil end
        end
    end)

    FH.addToggle("Player", "Noclip", function(on)
        if on then
            noclipConn = FH.RS.Stepped:Connect(function()
                local char = FH.LP.Character
                if char then
                    for _, v in pairs(char:GetDescendants()) do
                        if v:IsA("BasePart") and v.CanCollide then v.CanCollide = false end
                    end
                end
            end)
        else
            if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        end
    end)

    FH.addToggle("Player", "Infinite Jump", function(on)
        if on then
            infJumpConn = FH.UI.JumpRequest:Connect(function()
                local char = FH.LP.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                end
            end)
        else
            if infJumpConn then infJumpConn:Disconnect() infJumpConn = nil end
        end
    end)
end
