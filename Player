local FH = getgenv().FH
if not FH or FH.playerLoaded then return end
FH.playerLoaded = true

local cfg = {
    speed = false, speedVal = 50, jump = false, jumpVal = 100,
    inf = false, fly = false, flyVal = 60, noclip = false,
    grav = false, gravVal = 100, bhop = false, ctp = false, void = false
}
local orig = { ws = 16, jp = 50, up = true, grav = FH.WS.Gravity }
local infConn, bv, bg
local lastSafe

local function getHum()
    local c = FH.LP.Character
    return c and c:FindFirstChildOfClass("Humanoid"), c and c:FindFirstChild("HumanoidRootPart")
end

local function stopFly()
    if bv then bv:Destroy() bv = nil end
    if bg then bg:Destroy() bg = nil end
    local hum = getHum()
    if hum then hum.PlatformStand = false end
end

FH.onUnload(function()
    stopFly()
    if infConn then infConn:Disconnect() end
    FH.WS.Gravity = orig.grav
    local hum = getHum()
    if hum then
        if cfg.speed then hum.WalkSpeed = orig.ws end
        if cfg.jump then
            hum.UseJumpPower = orig.up
            hum.JumpPower = orig.jp
        end
    end
end)

FH.bind(FH.RS.Heartbeat, function()
    local hum, hrp = getHum()
    if cfg.grav and FH.WS.Gravity ~= cfg.gravVal then FH.WS.Gravity = cfg.gravVal end
    if not hum then return end

    if cfg.speed then hum.WalkSpeed = cfg.speedVal end
    if cfg.jump then
        hum.UseJumpPower = true
        hum.JumpPower = cfg.jumpVal
    end

    if cfg.bhop and hum.MoveDirection.Magnitude > 0 and hum.FloorMaterial ~= Enum.Material.Air then
        hum.Jump = true
    end

    if cfg.void and hrp then
        local h = FH.WS.FallenPartsDestroyHeight
        if h < -5000 then h = -500 end
        if hrp.Position.Y < h + 80 and lastSafe then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.CFrame = lastSafe + Vector3.new(0, 4, 0)
        elseif hum.FloorMaterial ~= Enum.Material.Air then
            lastSafe = hrp.CFrame
        end
    end

    if cfg.fly and hrp then
        if not bv or not bv.Parent then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
            bv.Parent = hrp
        end
        if not bg or not bg.Parent then
            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 9e4
            bg.Parent = hrp
        end
        hum.PlatformStand = true

        local cam = FH.WS.CurrentCamera
        local md = hum.MoveDirection
        local vel = Vector3.zero
        if md.Magnitude > 0 then
            local look = cam.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            local fw = flat.Magnitude > 0.01 and md:Dot(flat.Unit) or 0
            vel = md * cfg.flyVal + Vector3.new(0, look.Y * fw * cfg.flyVal, 0)
        end
        if FH.UI:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, cfg.flyVal, 0) end
        if FH.UI:IsKeyDown(Enum.KeyCode.LeftControl) then vel = vel - Vector3.new(0, cfg.flyVal, 0) end
        bv.Velocity = vel
        bg.CFrame = cam.CFrame
    end
end)

FH.bind(FH.RS.Stepped, function()
    if not cfg.noclip then return end
    local c = FH.LP.Character
    if not c then return end
    for _, v in ipairs(c:GetDescendants()) do
        if v:IsA("BasePart") then v.CanCollide = false end
    end
end)

local function tpToRay(ray)
    local _, hrp = getHum()
    if not hrp then return end
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = { FH.LP.Character }
    local r = FH.WS:Raycast(ray.Origin, ray.Direction * 2000, rp)
    if r then hrp.CFrame = CFrame.new(r.Position + Vector3.new(0, 3, 0)) end
end

FH.bind(FH.UI.TouchTap, function(pos, processed)
    if cfg.ctp and not processed and pos[1] then
        local cam = FH.WS.CurrentCamera
        tpToRay(cam:ScreenPointToRay(pos[1].X, pos[1].Y))
    end
end)

FH.bind(FH.UI.InputBegan, function(i, processed)
    if cfg.ctp and not processed and i.UserInputType == Enum.UserInputType.MouseButton1 and FH.UI:IsKeyDown(Enum.KeyCode.LeftControl) then
        local m = FH.UI:GetMouseLocation()
        local cam = FH.WS.CurrentCamera
        tpToRay(cam:ViewportPointToRay(m.X, m.Y))
    end
end)

FH.modules["Player"] = function()
    FH.crearSeccion("Movement")
    FH.crearOpcion("Speed", function(s)
        cfg.speed = s
        local hum = getHum()
        if s then
            if hum then orig.ws = hum.WalkSpeed end
        elseif hum then
            hum.WalkSpeed = orig.ws
        end
    end)
    FH.crearSlider("Speed Value", 16, 200, 50, function(v) cfg.speedVal = v end)

    FH.crearOpcion("Jump Power", function(s)
        cfg.jump = s
        local hum = getHum()
        if s then
            if hum then orig.jp, orig.up = hum.JumpPower, hum.UseJumpPower end
        elseif hum then
            hum.UseJumpPower = orig.up
            hum.JumpPower = orig.jp
        end
    end)
    FH.crearSlider("Jump Value", 50, 300, 100, function(v) cfg.jumpVal = v end)

    FH.crearOpcion("Infinite Jump", function(s)
        cfg.inf = s
        if infConn then infConn:Disconnect() infConn = nil end
        if s then
            infConn = FH.UI.JumpRequest:Connect(function()
                local hum = getHum()
                if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
            end)
        end
    end)

    FH.crearOpcion("Bunny Hop", function(s) cfg.bhop = s end, "Auto jump while moving")

    FH.crearOpcion("Fly", function(s)
        cfg.fly = s
        if not s then stopFly() end
    end, "PC: Space up, Ctrl down | Mobile: look up or down")
    FH.crearSlider("Fly Speed", 20, 200, 60, function(v) cfg.flyVal = v end)

    FH.crearSeccion("Physics")
    FH.crearOpcion("Noclip", function(s) cfg.noclip = s end, "Walk through walls")
    FH.crearOpcion("Custom Gravity", function(s)
        cfg.grav = s
        if not s then FH.WS.Gravity = orig.grav end
    end)
    FH.crearSlider("Gravity", 0, 196, 100, function(v) cfg.gravVal = v end)

    FH.crearSeccion("Utility")
    FH.crearOpcion("Click Teleport", function(s) cfg.ctp = s end, "PC: Ctrl + Click | Mobile: tap the ground")
    FH.crearOpcion("Anti Void", function(s) cfg.void = s end, "Return to safe ground when falling")
end
